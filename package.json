{
  "name": "fatinah",
  "version": "1.2.0",
  "description": "فَطِنة — لعبة الذكاء والفطنة الجماعية",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-ios-dependencies.mjs",
    "sync": "npx cap sync",
    "open:ios": "npx cap open ios",
    "build:ios": "npx cap sync ios && npx cap open ios",
    "test": "npm run test:static && npm run test:web && npm run test:server",
    "test:static": "node tests/ios_privacy_config_test.mjs && node tests/subscription_routing_test.mjs",
    "test:web": "node tests/paywall_prices_test.mjs && node tests/auth_flows_test.mjs && node tests/game_flow_test.mjs && node tests/responsive_accessibility_test.mjs",
    "test:server": "python3 tests/test_revenuecat_webhook.py && python3 tests/test_account_delete.py"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor-firebase/authentication": "8.4.0",
    "@capacitor-firebase/crashlytics": "^8.4.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^13.4.0",
    "firebase": "^12.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "playwright": "^1.62.1"
  },
  "overrides": {
    "brace-expansion": ">=5.0.9"
  }
}
