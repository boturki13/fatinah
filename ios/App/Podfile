require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '16.0'
use_frameworks!

install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityKeepAwake', :path => '../../node_modules/@capacitor-community/keep-awake'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorFirebaseCrashlytics', :path => '../../node_modules/@capacitor-firebase/crashlytics'
  pod 'CapacitorFirebaseMessaging', :path => '../../node_modules/@capacitor-firebase/messaging'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorPreferences', :path => '../../node_modules/@capacitor/preferences'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
  pod 'RevenuecatPurchasesCapacitor', :path => '../../node_modules/@revenuecat/purchases-capacitor'
end

target 'App' do
  capacitor_pods
  # Google Sign-In is an optional authentication subspec. Without it the
  # JavaScript call reaches the native plugin but the provider implementation
  # is compiled out and the promise never resolves.
  pod 'CapacitorFirebaseAuthentication/Google', :path => '../../node_modules/@capacitor-firebase/authentication'
end

post_install do |installer|
  # أبقِ مشروع Pods على إعدادات Xcode الحالية دون تفعيل Module Verifier.
  # تم اختباره مع Xcode 26.6 وCocoaPods 1.16: تفعيله يفشل في nanopb
  # بسبب double-quoted framework headers، لذلك يُعطّل صراحةً حتى يصل إصلاح upstream.
  installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '2660'

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      # أطر Pods تُضمّن داخل التطبيق ولا ينبغي توقيع كل إطار أثناء بنائه.
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      # إعدادات Xcode الموصى بها للأطر، محفوظة هنا كي لا تضيع
      # عند إعادة إنشاء Pods.xcodeproj في أي pod install لاحق.
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'

      # الإصدار 8.4.0 هو أحدث إصدار منشور من الإضافة. واجهات التوافق القديمة
      # داخله تستدعي Firebase APIs معلّمة deprecated حتى تبقى JavaScript API
      # مستقرة؛ اخفِ تحذيرات هذا الهدف فقط ولا تخفِ تحذيرات التطبيق.
      dependency_targets_with_upstream_warnings = %w[
        Capacitor
        CapacitorFirebaseAuthentication
        CapacitorFirebaseCrashlytics
        CapacitorFirebaseMessaging
        RevenuecatPurchasesCapacitor
      ]
      if dependency_targets_with_upstream_warnings.include?(target.name)
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      end

      if target.name == 'Pods-App'
        config.build_settings.delete('EMBEDDED_CONTENT_CONTAINS_SWIFT')
        config.build_settings.delete('ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES')
      end
    end
  end
  assertDeploymentTarget(installer)

  # إصلاح خطأ RecaptchaInterop: double-quoted includes في framework headers
  recaptcha_headers = [
    'Pods/RecaptchaInterop/RecaptchaEnterprise/RecaptchaInterop/Public/RecaptchaInterop/RCARecaptchaClientProtocol.h',
    'Pods/RecaptchaInterop/RecaptchaEnterprise/RecaptchaInterop/Public/RecaptchaInterop/RCARecaptchaProtocol.h',
    'Pods/RecaptchaInterop/RecaptchaEnterprise/RecaptchaInterop/Public/RecaptchaInterop/RecaptchaInterop.h',
    'Pods/Target Support Files/RecaptchaInterop/RecaptchaInterop-umbrella.h',
  ]
  recaptcha_headers.each do |header_path|
    full_path = File.join(File.dirname(__FILE__), header_path)
    next unless File.exist?(full_path)
    content = File.read(full_path)
    updated = content.gsub(/#import "RCAActionProtocol\.h"/, '#import <RecaptchaInterop/RCAActionProtocol.h>')
                     .gsub(/#import "RCARecaptchaClientProtocol\.h"/, '#import <RecaptchaInterop/RCARecaptchaClientProtocol.h>')
                     .gsub(/#import "RCARecaptchaProtocol\.h"/, '#import <RecaptchaInterop/RCARecaptchaProtocol.h>')
                     .gsub(/#import "RecaptchaInterop\.h"/, '#import <RecaptchaInterop/RecaptchaInterop.h>')
    File.write(full_path, updated) if updated != content
  end
end
