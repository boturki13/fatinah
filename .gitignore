node_modules/
.DS_Store

# Runtime databases and journals may contain account or purchase identifiers.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
firebase-debug.log
.env.local
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Local review artifacts and generated screenshots
work/

# Raw pasted diagnostics may contain authentication or SDK identity payloads.
# Commit a deliberately redacted fixture elsewhere when a log is needed by a test.
attached_assets/Pasted-*.txt
attached_assets/*.log

# Xcode build products and local archives
DerivedData/
build/
*.xcarchive
*.ipa
*.xcresult
*.dSYM

# Local Swift/Xcode user state
.swiftpm/
xcuserdata/
*.xcuserstate

# Local credentials and environment overrides
.env
.env.*
!.env.example
*.p12
*.p8
*.pem
*.key
*.mobileprovision
*service-account*.json
*service_account*.json
firebase-adminsdk-*.json

# Production media is distributed from the verified asset host, not Git history.
# The release manifest and provenance stay tracked so every binary can be fetched
# and verified by size and SHA-256 on a clean checkout.
server-assets/question-images/**/*.avif
server-assets/question-images/**/*.webp
server-assets/question-images/**/*.jpg
server-assets/question-images/**/*.jpeg
server-assets/question-images/**/*.png
