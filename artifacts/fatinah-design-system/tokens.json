      "chart3": { "$value": "#FFB067" },
      "chart4": { "$value": "#FFD24B" },
      "chart5": { "$value": "#C026A8" },
      "sidebar": { "$value": "#1B1035" },
      "sidebarForeground": { "$value": "#F4EEFF" },
      "sidebarBorder": { "$value": "#45356B" },
      "sidebarPrimary": { "$value": "#FF3D71" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#2E1A57" },
      "sidebarAccentForeground": { "$value": "#F4EEFF" },
      "sidebarRing": { "$value": "#FF3D71" }
    },
    "dark": {
      "background": { "$value": "#120B24" },
      "foreground": { "$value": "#F4EEFF" },
      "border": { "$value": "#45356B" },
      "card": { "$value": "#241546" },
      "cardForeground": { "$value": "#F4EEFF" },
      "popover": { "$value": "#1B1035" },
      "popoverForeground": { "$value": "#F4EEFF" },
      "primary": { "$value": "#FF3D71" },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#2E1A57" },
      "secondaryForeground": { "$value": "#F4EEFF" },
      "muted": { "$value": "#2E1A57" },
      "mutedForeground": { "$value": "#A99BC9" },
      "accent": { "$value": "#C026A8" },
      "accentForeground": { "$value": "#FFFFFF" },
      "destructive": { "$value": "#FF5A6E" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#1B1035" },
      "ring": { "$value": "#FF3D71" },
      "chart1": { "$value": "#FF3D71" },
      "chart2": { "$value": "#4FE3C4" },
      "chart3": { "$value": "#FFB067" },
      "chart4": { "$value": "#FFD24B" },
      "chart5": { "$value": "#C026A8" },
      "sidebar": { "$value": "#1B1035" },
      "sidebarForeground": { "$value": "#F4EEFF" },
      "sidebarBorder": { "$value": "#45356B" },
      "sidebarPrimary": { "$value": "#FF3D71" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#2E1A57" },
      "sidebarAccentForeground": { "$value": "#F4EEFF" },
      "sidebarRing": { "$value": "#FF3D71" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Tajawal", "system-ui", "sans-serif"],
        "$description": "Arabic-first UI typeface used by the source application."
      },
      "serif": { "$value": ["Tajawal", "system-ui", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.875rem",
      "$description": "Base control radius; cards and dialogs use the larger 20px and 24px treatments documented in docs/AGENTS.md."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel spacing rhythm used throughout the source app."
    }
  },
  "brand": {
    "$description": "Fatinah-specific visual tokens extracted from the source CSS. These are generated as --fatinah-* variables for web consumers.",
    "surface": {
      "deep": { "$value": "#120B24" },
      "base": { "$value": "#1B1035" },
      "card": { "$value": "#241546" },
      "raised": { "$value": "#2E1A57" },
      "glass": { "$value": "rgba(255,255,255,0.06)" },
      "line": { "$value": "rgba(255,255,255,0.10)" },
      "lineStrong": { "$value": "rgba(255,255,255,0.16)" }
    },
    "text": {
      "primary": { "$value": "#F4EEFF" },
      "muted": { "$value": "#A99BC9" },
      "dim": { "$value": "#7A6BA0" }
    },
    "fire": {
      "yellow": { "$value": "#FFD24B" },
      "amber": { "$value": "#FFA836" },
      "orange": { "$value": "#FF7A3D" },
      "coral": { "$value": "#FF4D6A" },
      "pink": { "$value": "#F42B7C" },
      "magenta": { "$value": "#C026A8" },
      "hot": { "$value": "#FF3D71" },
      "hotSecondary": { "$value": "#FF6B35" }
    },
    "teams": {
      "violet": { "$value": "#B794FF" },
      "teal": { "$value": "#4FE3C4" },
      "peach": { "$value": "#FFB067" }
    },
    "state": {
      "success": { "$value": "#3DDC84" },
      "error": { "$value": "#FF5A6E" },
      "gold": { "$value": "#FFD24B" }
    },
    "gradient": {
      "page": { "$value": "radial-gradient(140% 100% at 50% 0%, #2A1550 0%, #1B1035 45%, #120B24 100%)" },
      "brand": { "$value": "linear-gradient(120deg, #FFD24B, #FF3D71 55%, #C026A8)" },
      "action": { "$value": "linear-gradient(120deg, #FF6B35, #FF3D71)" },
      "modal": { "$value": "linear-gradient(180deg, #241546, #1B1035)" }
    },
    "shadow": {
      "elevated": { "$value": "0 10px 40px rgba(0,0,0,0.45)" },
      "hot": { "$value": "0 8px 24px rgba(255,61,113,0.40)" },
      "focus": { "$value": "0 0 24px" }
    },
    "motion": {
      "fast": { "$value": "120ms" },
      "standard": { "$value": "250ms" },
      "entrance": { "$value": "400ms" }
    }
  }
}
