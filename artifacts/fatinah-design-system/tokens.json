{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. This system is extracted from fatinah-replit.zip and is dark-first by design. Edit tokens.json only; generated CSS and portable tokens are rebuilt by scripts/build-tokens.mjs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#120B24" },
      "foreground": { "$value": "#F4EEFF" },
      "border": { "$value": "#45356B" },
      "card": { "$value": "#241546" },
      "cardForeground": { "$value": "#F4EEFF" },
      "popover": { "$value": "#1B1035" },
      "popoverForeground": { "$value": "#F4EEFF" },
      "primary": {
        "$value": "#FF3D71",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#2E1A57" },
      "secondaryForeground": { "$value": "#F4EEFF" },
      "muted": { "$value": "#2E1A57" },
      "mutedForeground": { "$value": "#A99BC9" },
      "accent": { "$value": "#C026A8" },
      "accentForeground": { "$value": "#FFFFFF" },
      "destructive": { "$value": "#FF5A6E" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#1B1035" },
      "ring": { "$value": "#FF3D71" },
