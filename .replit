run = "python3 server.py"
entrypoint = "server.py"
modules = ["python-base-3.13", "nodejs-24"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 server.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
FATINAH_ENVIRONMENT = "staging"
FIREBASE_APP_ID = "1:508338410340:web:72f2f45f3499a6c0a52071"
FIREBASE_AUTH_DOMAIN = "fatinah-game.firebaseapp.com"
FIREBASE_MESSAGING_SENDER_ID = "508338410340"
FIREBASE_PROJECT_ID = "fatinah-game"
FIREBASE_STORAGE_BUCKET = "fatinah-game.firebasestorage.app"
REVENUECAT_IOS_API_KEY = "appl_uqcDNORwLPcxPWRUDjmPPpoMeNM"
